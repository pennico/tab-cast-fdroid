      "suggestedVersionCode": "17",
      "description": "An Android tablet app that finds the video on any web page and casts it to\nTab Cast TV, an FCast receiver or a Chromecast, without Google Play Services.\nIt also casts files from the tablet and mirrors the tablet's screen.\n\nFree software (GPL-3.0-or-later). Source code: https://github.com/pennico/tab-cast",
      "issueTracker": "https://github.com/pennico/tab-cast/issues",
      "license": "GPL-3.0-or-later",
      "name": "Tab Cast",
      "sourceCode": "https://github.com/pennico/tab-cast",
      "summary": "Casts the video of any web page from the tablet to the TV",
      "added": 1795684047000,
      "packageName": "dk.pennico.tabcast",
      "lastUpdated": 1795824087000,
      "localized": {
        "en-US": {
          "whatsNew": "Check for updates is now in the main menu, and the TV remote can check the TV for updates too.\n"
        }
      }
    },
    {
      "authorName": "pennico",
      "categories": [
        "Multimedia"
      ],
      "suggestedVersionCode": "15",
      "description": "A browser for Android TV that plays a web page's video full screen,\ncontrolled from the Tab Cast tablet app or a web remote.\n\nFree software (GPL-3.0-or-later). Source code: https://github.com/pennico/tab-cast",
      "issueTracker": "https://github.com/pennico/tab-cast/issues",
      "license": "GPL-3.0-or-later",
      "name": "Tab Cast TV",
      "sourceCode": "https://github.com/pennico/tab-cast",
      "summary": "The browser on the TV that Tab Cast controls",
      "added": 1795635437000,
      "packageName": "dk.pennico.tabcast.tv",
      "lastUpdated": 1795824085000,
      "localized": {
        "en-US": {
          "whatsNew": "Preview: the sound of a mirrored screen (tablet or Mac) and its picture now come out about 0.1 s sooner. The start screen always has a Check for updates button, and so does the browser remote.\n"
        }
      }
    }
